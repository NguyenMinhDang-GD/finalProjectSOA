@startuml UC_GUEST_AND_CUSTOMER
title Use Case Diagram — Guest & Customer
left to right direction

actor "Guest" as Guest
actor "Customer (CUSTOMER)" as Customer
Guest <|-- Customer

rectangle "Public & Customer Flows" {
  usecase "Browse Courts & Availability\n(GET /api/courts/availability)" as UC1
  usecase "Register / Login\n(POST /api/auth/register, /login)" as UC2
  usecase "Create Booking\n(POST /api/bookings)" as UC3
  usecase "Lookup Booking & QR\n(GET /api/bookings/lookup/{code},\n/api/checkin/ticket/{code})" as UC4
  usecase "Create Payment & Demo Webhook\n(POST /api/payments/create, /retry)" as UC5
  usecase "Quote & Reschedule Booking\n(POST /api/bookings/{code}/reschedule*)" as UC6
  usecase "Quote & Cancel Booking\n(GET /cancellation-quote, POST /cancel)" as UC7
  usecase "View My Bookings\n(GET /api/bookings/my)" as UC8
}

Guest --> UC1
Guest --> UC2
Guest --> UC3
Guest --> UC4
Guest --> UC5
Guest --> UC6
Guest --> UC7
Customer --> UC8

UC3 ..> UC1 : <<include>>
UC6 ..> UC1 : <<include>>
@enduml


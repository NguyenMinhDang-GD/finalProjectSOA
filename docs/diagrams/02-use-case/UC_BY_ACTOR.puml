  usecase "View Check-in & Booking Lists\n(GET /api/checkin/logs, /api/bookings/admin/list)" as S2
  usecase "Create Walk-in Booking\n(POST /api/bookings/staff/walk-in)" as S3
  usecase "Collect Simulated Cash\n(POST /api/payments/staff/cash-collect)" as S4
  usecase "Mark Booking No-Show\n(POST /api/bookings/staff/{code}/no-show)" as S5
  usecase "Complete Booking\n(POST /api/bookings/staff/{code}/complete)" as S6
  usecase "View Court Maintenance\n(GET /api/bookings/maintenance)" as S7
}

Staff --> S1
Staff --> S2
Staff --> S3
Staff --> S4
Staff --> S5
Staff --> S6
Staff --> S7
S3 ..> S4 : <<extend>>
@enduml


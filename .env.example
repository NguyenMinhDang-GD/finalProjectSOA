# PostgreSQL
POSTGRES_USER=pickleball
POSTGRES_PASSWORD=pickleball_secret

# Security Secrets
JWT_SECRET=soa-pickleball-jwt-super-secret-key-2026
JWT_EXPIRE_MINUTES=1440
QR_HMAC_SECRET=soa-pickleball-qr-hmac-secret-key-2026
WEBHOOK_SECRET=soa-pickleball-webhook-hmac-secret-2026
INTERNAL_API_KEY=soa-pickleball-internal-service-key-2026

# VietQR & Payment
VIETQR_BANK_BIN=970422
VIETQR_ACCOUNT_NO=0123456789
VIETQR_ACCOUNT_NAME=SAN PICKLEBALL SOA
ENABLE_DEMO_WEBHOOK=true

# Check-in Demo Helper
ALLOW_DEMO_BYPASS_TIME=true

# SMTP Email (Default: Mailpit local test server at http://localhost:8025)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM=noreply@pickleball-soa.vn

# Uncomment below to send real Gmail (requires Google App Password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_16_char_app_password
# SMTP_USE_TLS=true
# SMTP_FROM=your_email@gmail.com

# Ngrok Public HTTPS Tunnel (run: docker compose --profile tunnel up -d)
NGROK_AUTHTOKEN=
